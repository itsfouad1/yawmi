{
  "name": "yawmi-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "واجهة تطبيق مهام يومية عربية لسطح المكتب",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "concurrently -k \"npm:dev\" \"npm:electron\"",
    "electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "tsc -b && vite build",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "build": {
    "appId": "com.yawmi.desktop",
    "productName": "يومي",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/yawmi.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "يومي"
    },
    "artifactName": "Yawmi-Setup-${version}.${ext}"
  },
  "overrides": {
    "yauzl": "^3.3.1"
  },
  "allowScripts": {
    "electron": true
  }
}
